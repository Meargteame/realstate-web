generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  password     String
  role         String        @default("user")
  resetToken       String?
  resetTokenExpiry DateTime?
  agentId      String?       @unique
  agent        Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  favorites    Favorite[]
  savedSearches SavedSearch[]
  documents    Document[]    @relation("UploadedDocuments")
  documentVersions DocumentVersion[]
  documentAccess DocumentAccess[]
  comparisons  PropertyComparison[]
  createdAt    DateTime      @default(now())
}

model Agent {
  id            String        @id @default(uuid())
  name          String
  phone         String
  email         String        @unique
  imageUrl      String
  brokerage     String
  rating        Float         @default(0.0)
  reviews       Int           @default(0)
  license       String
  languages     String[]
  isLuxury      Boolean       @default(false)
  bio           String?
  location      String?
  specialties   String?
  
  // Phase 1: New Fields
  videoUrl      String?       // YouTube/Vimeo embed URL
  certifications String[]     @default([]) // Professional certifications
  socialMedia   Json?         // { facebook, instagram, linkedin, twitter }
  officeHours   Json?         // { monday: {open,close,closed}, ... }
  
  // Performance Metrics
  totalSales    Int           @default(0)
  totalVolume   BigInt        @default(0)
  avgResponseTime Int?        // in minutes
  conversionRate Float?       // percentage
  
  // Status & Verification
  isActive      Boolean       @default(true)
  isVerified    Boolean       @default(false)
  verifiedAt    DateTime?
  lastActive    DateTime?
  
  // SEO
  slug          String?       @unique
  
  // Timestamps
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  user          User?
  properties    Property[]
  leads         Lead[]
  opportunities Opportunity[]
  openHouses    OpenHouse[]
  agentReviews  Review[]
  blogPosts     BlogPost[]
  
  @@index([email])
  @@index([location, isActive])
  @@index([rating, reviews])
  @@index([slug])
  @@map("agents")
}

model Property {
  id           String        @id @default(uuid())
  price        Int
  beds         Float
  baths        Float
  sqft         Int
  address      String
  city         String
  state        String
  zip          String
  imageUrl     String        @default("https://images.unsplash.com/photo-1568605114967-8130f3a36994?w=800")
  status       String        @default("Active")
  propertyType String        @default("Single Family")
  latitude     Float?
  longitude    Float?
  geocoded     Boolean       @default(false)
  
  // Phase 1 & 7A: Advanced Filters
  lotSize      Int?          // in square feet
  yearBuilt    Int?
  hasGarage    Boolean       @default(false)
  garageSpaces Int?
  hasPool      Boolean       @default(false)
  features     String[]      @default([]) // ["hardwood floors", "granite counters", etc.]
  
  // Phase 7A: Additional Advanced Filters
  hoaFees          Int?          // Monthly HOA fees
  hasBasement      Boolean       @default(false)
  hasFireplace     Boolean       @default(false)
  isWaterfront     Boolean       @default(false)
  isPetFriendly    Boolean       @default(false)
  stories          Int           @default(1)
  condition        String        @default("Good") // New, Excellent, Good, Fair, Needs Work
  daysOnMarket     Int           @default(0)
  parkingSpaces    Int           @default(0)
  heating          String?       // Central, Gas, Electric, etc.
  cooling          String?       // Central AC, Window Units, etc.
  roofType         String?       // Shingle, Tile, Metal, etc.
  flooring         String[]      @default([]) // Hardwood, Carpet, Tile, etc.
  appliances       String[]      @default([]) // Refrigerator, Dishwasher, etc.
  exteriorFeatures String[]      @default([]) // Deck, Patio, Fence, etc.
  interiorFeatures String[]      @default([]) // Walk-in Closet, High Ceilings, etc.
  
  // Performance & Analytics Fields
  viewCount    Int           @default(0)
  leadCount    Int           @default(0)
  shareCount   Int           @default(0)
  lastViewed   DateTime?
  listedAt     DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdAt    DateTime      @default(now())
  
  // SEO & Marketing
  slug         String?       @unique
  metaTitle    String?
  metaDescription String?
  
  // Data Quality
  dataQuality  Int           @default(0) // 0-100 score
  isVerified   Boolean       @default(false)
  verifiedAt   DateTime?
  
  agent        Agent         @relation(fields: [agentId], references: [id])
  agentId      String
  leads        Lead[]
  favorites    Favorite[]
  searchAlerts SearchAlert[]
  openHouses   OpenHouse[]
  virtualTours VirtualTour[]
  documents    Document[]
  priceHistory PropertyPriceHistory[]
  
  // Critical Performance Indexes
  @@index([city, state, status])
  @@index([price, beds, baths])
  @@index([latitude, longitude])
  @@index([agentId, status])
  @@index([status, listedAt])
  @@index([zip, status])
  @@index([slug])
  @@map("properties")
}

model Lead {
  id            String    @id @default(uuid())
  name          String
  email         String
  phone         String
  message       String
  status        String    @default("New")
  type          String?
  date          DateTime  @default(now())
  isFavorite    Boolean   @default(false)
  notes         String?
  lastContacted DateTime?
  createdAt     DateTime  @default(now())

  // Lead intelligence
  source            String?   // website, referral, phone, social, ad, zillow, etc.
  tags              String[]  @default([]) // quick categorisation: urgent, vip, cold, ...
  nextFollowUpDate  DateTime? // scheduled next contact

  agent      Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId    String

  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  propertyId String?

  documents     Document[]
  opportunities Opportunity[]
}

model Opportunity {
  id          String   @id @default(uuid())
  name        String
  type        String   @default("listing")
  dealType    String
  price       Int
  status      String   @default("Cultivate")
  probability Int      @default(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Deal detail
  expectedCloseDate DateTime?
  notes             String?

  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId     String

  // Link back to the lead this deal originated from (nullable for legacy data)
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId      String?
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())
  
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  @@unique([userId, propertyId])
}

model SavedSearch {
  id            String   @id @default(uuid())
  userId        String
  name          String
  filters       Json     // Store all search criteria including map area
  emailAlerts   Boolean  @default(true)
  frequency     String   @default("daily") // daily, instant, weekly
  lastRun       DateTime?
  lastNotified  DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts        SearchAlert[]
}

model SearchAlert {
  id             String      @id @default(uuid())
  savedSearchId  String
  propertyId     String
  sentAt         DateTime    @default(now())
  emailSent      Boolean     @default(false)
  viewed         Boolean     @default(false)
  
  savedSearch    SavedSearch @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)
  property       Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  @@unique([savedSearchId, propertyId])
}

model OpenHouse {
  id          String   @id @default(uuid())
  propertyId  String
  agentId     String
  startTime   DateTime
  endTime     DateTime
  description String?
  status      String   @default("scheduled") // scheduled, cancelled, completed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  rsvps       RSVP[]
}

model RSVP {
  id           String    @id @default(uuid())
  openHouseId  String
  name         String
  email        String
  phone        String?
  guests       Int       @default(1)
  message      String?
  status       String    @default("confirmed") // confirmed, cancelled
  createdAt    DateTime  @default(now())
  
  openHouse    OpenHouse @relation(fields: [openHouseId], references: [id], onDelete: Cascade)
  
  @@unique([openHouseId, email])
}

model Review {
  id              String   @id @default(uuid())
  agentId         String
  reviewerName    String
  reviewerEmail   String
  rating          Int      // 1-5 stars
  comment         String
  transactionType String   // "buyer", "seller", "rental"
  verified        Boolean  @default(false)
  agentResponse   String?
  status          String   @default("published") // published, flagged, removed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  agent           Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model VirtualTour {
  id          String   @id @default(uuid())
  propertyId  String
  type        String   // "360photo", "matterport", "youtube", "video"
  url         String
  title       String?
  description String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model MarketData {
  id              String   @id @default(uuid())
  zipCode         String   @unique
  city            String
  state           String
  avgPrice        Int?
  medianPrice     Int?
  avgDaysOnMarket Int?
  pricePerSqft    Int?
  inventoryCount  Int?
  salesVolume     Int?
  priceChange     Float?   // Percentage change from last period
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

model Conversation {
  id          String    @id @default(uuid())
  leadId      String    @unique
  agentId     String
  lastMessage String?
  lastMessageAt DateTime?
  unreadCount Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  messages    Message[]
  
  @@index([agentId, lastMessageAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String       // Can be agent ID or lead email
  senderType     String       // "agent" or "lead"
  content        String
  isRead         Boolean      @default(false)
  readAt         DateTime?    // Phase 4: When message was read
  attachments    Json?        // Phase 4: File attachments [{name, url, type, size}]
  createdAt      DateTime     @default(now())
  
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  @@index([conversationId, createdAt])
}

// Phase 4: SMS Integration
model SMSMessage {
  id          String   @id @default(uuid())
  to          String   // Phone number
  from        String   // Twilio number
  body        String
  status      String   // queued, sent, delivered, failed
  sid         String?  // Twilio message SID
  leadId      String?
  agentId     String?
  direction   String   // inbound, outbound
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([leadId])
  @@index([agentId])
  @@index([status])
}

// Phase 4: Email Integration
model EmailMessage {
  id          String   @id @default(uuid())
  to          String
  from        String
  subject     String
  body        String   // HTML content
  status      String   // queued, sent, delivered, failed
  messageId   String?  // Email service message ID
  leadId      String?
  agentId     String?
  attachments Json?    // [{name, url, type, size}]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([leadId])
  @@index([agentId])
  @@index([status])
}

// Phase 2: Blog/Content System
model BlogPost {
  id              String    @id @default(uuid())
  title           String
  slug            String    @unique
  content         String    // Rich text content
  excerpt         String?   // Short summary
  coverImage      String?
  authorId        String
  authorName      String    // Denormalized for performance
  status          String    @default("draft") // draft, published, archived
  featured        Boolean   @default(false)
  viewCount       Int       @default(0)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  author          Agent     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tags            BlogTag[]
  categories      BlogCategory[]
  
  @@index([status, publishedAt])
  @@index([slug])
  @@index([authorId])
}

model BlogTag {
  id        String     @id @default(uuid())
  name      String     @unique
  slug      String     @unique
  posts     BlogPost[]
  createdAt DateTime   @default(now())
}

model BlogCategory {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  posts       BlogPost[]
  createdAt   DateTime   @default(now())
}

model EmailTemplate {
  id          String   @id @default(uuid())
  name        String
  subject     String
  content     String   // HTML content with variables
  variables   String[] // Available variables like {{name}}, {{property}}
  type        String   // welcome, follow_up, listing_alert, etc.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([type, isActive])
}

// Phase 5: Calendar & Scheduling System
model CalendarEvent {
  id              String    @id @default(uuid())
  title           String
  description     String?
  startTime       DateTime
  endTime         DateTime
  location        String?
  eventType       String    // showing, appointment, open_house, meeting, personal
  status          String    @default("scheduled") // scheduled, cancelled, completed
  allDay          Boolean   @default(false)
  agentId         String
  leadId          String?
  propertyId      String?
  isRecurring     Boolean   @default(false)
  recurrenceRule  String?   // RRULE format for recurring events
  parentEventId   String?   // For recurring event instances
  reminderMinutes Int[]     @default([15, 60])
  googleEventId   String?   // Google Calendar sync
  outlookEventId  String?   // Outlook Calendar sync
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([agentId, startTime])
  @@index([leadId])
  @@index([propertyId])
  @@index([status])
  @@map("CalendarEvent")
}

model Availability {
  id          String   @id @default(uuid())
  agentId     String
  dayOfWeek   Int      // 0-6 where 0=Sunday, 6=Saturday
  startTime   String   // HH:MM format (e.g., "09:00")
  endTime     String   // HH:MM format (e.g., "17:00")
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([agentId, dayOfWeek, startTime])
  @@index([agentId])
  @@map("Availability")
}

model BookingRequest {
  id               String   @id @default(uuid())
  agentId          String
  leadName         String
  leadEmail        String
  leadPhone        String?
  propertyId       String?
  requestedDate    DateTime
  requestedTime    String   // HH:MM format
  duration         Int      @default(60) // minutes
  message          String?
  status           String   @default("pending") // pending, confirmed, rejected, cancelled
  confirmedEventId String?  // Link to CalendarEvent if confirmed
  serviceType      String?  // showing, appraisal, inspection, consultation
  timezone         String?  // IANA tz of the requester, e.g. America/New_York
  rejectionReason  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([agentId, status])
  @@index([status])
  @@map("BookingRequest")
}

// Phase 6: Video Chat & WebRTC System
model VideoCall {
  id           String   @id @default(uuid())
  roomId       String   @unique
  agentId      String
  leadId       String?
  leadName     String?
  leadEmail    String?
  propertyId   String?
  status       String   @default("scheduled") // scheduled, active, completed, cancelled
  startTime    DateTime?
  endTime      DateTime?
  duration     Int?     // in seconds
  recordingUrl String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  participants VideoCallParticipant[]
  tourSessions VirtualTourSession[]
  
  @@index([agentId])
  @@index([roomId])
  @@index([status])
  @@map("VideoCall")
}

model VirtualTourSession {
  id               String    @id @default(uuid())
  videoCallId      String
  propertyId       String
  agentId          String
  viewerCount      Int       @default(0)
  chatEnabled      Boolean   @default(true)
  screenSharing    Boolean   @default(false)
  recordingEnabled Boolean   @default(false)
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  createdAt        DateTime  @default(now())
  
  videoCall        VideoCall @relation(fields: [videoCallId], references: [id], onDelete: Cascade)
  
  @@index([propertyId])
  @@index([agentId])
  @@map("VirtualTourSession")
}

model VideoCallParticipant {
  id               String    @id @default(uuid())
  videoCallId      String
  participantName  String
  participantEmail String?
  role             String    @default("viewer") // host, viewer, guest
  joinedAt         DateTime  @default(now())
  leftAt           DateTime?
  duration         Int?      // in seconds
  createdAt        DateTime  @default(now())
  
  videoCall        VideoCall @relation(fields: [videoCallId], references: [id], onDelete: Cascade)
  
  @@index([videoCallId])
  @@map("VideoCallParticipant")
}

// Phase 6: Video Chat & Virtual Tours
model VideoCallLog {
  id            String   @id @default(uuid())
  roomName      String
  roomSid       String
  participants  String[] // Array of participant identities
  duration      Int?     // Duration in seconds
  status        String   // completed, failed
  provider      String   @default("mock")
  recordingUrl  String?
  createdAt     DateTime @default(now())
  endedAt       DateTime?
  
  @@index([roomName])
  @@index([status])
  @@map("VideoCallLog")
}

// Phase 7C: Document Management System
model Document {
  id          String   @id @default(uuid())
  name        String
  fileName    String
  fileUrl     String
  fileSize    Int
  fileType    String
  category    String   @default("general") // contract, disclosure, inspection, listing, offer, general
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  uploadedBy  String
  uploader    User      @relation("UploadedDocuments", fields: [uploadedBy], references: [id], onDelete: Cascade)
  sharedWith  String[]  @default([]) // User IDs
  version     Int       @default(1)
  status      String    @default("active") // active, archived, deleted
  description String?
  tags        String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  versions    DocumentVersion[]
  accessLogs  DocumentAccess[]
  
  @@index([uploadedBy])
  @@index([propertyId])
  @@index([leadId])
  @@index([category, status])
  @@index([createdAt(sort: Desc)])
  @@map("Document")
}

model DocumentVersion {
  id          String   @id @default(uuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version     Int
  fileUrl     String
  fileSize    Int
  uploadedBy  String
  uploader    User     @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  changeNote  String?
  createdAt   DateTime @default(now())
  
  @@index([documentId])
  @@map("DocumentVersion")
}

model DocumentAccess {
  id          String   @id @default(uuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String   // view, download, share, delete
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  
  @@index([documentId])
  @@index([userId])
  @@map("DocumentAccess")
}

// Phase 7D: Enhanced Property Features
model PropertyPriceHistory {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  price      Float
  changeType String   // listed, reduced, increased
  changedAt  DateTime @default(now())
  
  @@index([propertyId])
  @@index([changedAt(sort: Desc)])
  @@map("PropertyPriceHistory")
}

model PropertyComparison {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyIds String[]
  name        String?
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@map("PropertyComparison")
}
