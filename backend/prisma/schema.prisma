generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  role      String     @default("user")
  agentId   String?
  favorites Favorite[]
  createdAt DateTime   @default(now())
}

model Agent {
  id            String        @id @default(uuid())
  name          String
  phone         String
  email         String        @unique
  imageUrl      String
  brokerage     String
  rating        Float         @default(0.0)
  reviews       Int           @default(0)
  license       String
  languages     String[]
  isLuxury      Boolean       @default(false)
  bio           String?
  location      String?
  specialties   String?
  properties    Property[]
  leads         Lead[]
  opportunities Opportunity[]
}

model Property {
  id           String     @id @default(uuid())
  price        Int
  beds         Float
  baths        Float
  sqft         Int
  address      String
  city         String
  state        String
  zip          String
  imageUrl     String     @default("https://images.unsplash.com/photo-1568605114967-8130f3a36994?w=800")
  status       String     @default("Active")
  propertyType String     @default("Single Family")
  
  agent        Agent      @relation(fields: [agentId], references: [id])
  agentId      String
  leads        Lead[]
  favorites    Favorite[]
}

model Lead {
  id            String    @id @default(uuid())
  name          String
  email         String
  phone         String
  message       String
  status        String    @default("New")
  type          String?
  date          DateTime  @default(now())
  isFavorite    Boolean   @default(false)
  notes         String?
  lastContacted DateTime?
  createdAt     DateTime  @default(now())
  
  agent      Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId    String
  
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  propertyId String?
}

model Opportunity {
  id          String   @id @default(uuid())
  name        String
  type        String   @default("listing")
  dealType    String
  price       Int
  status      String   @default("Cultivate")
  probability Int      @default(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId     String
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())
  
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  @@unique([userId, propertyId])
}
