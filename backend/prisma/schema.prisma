generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user")
  agentId   String?
  createdAt DateTime @default(now())
}

model Agent {
  id         String     @id @default(uuid())
  name       String
  phone      String
  email      String     @unique
  imageUrl   String
  brokerage  String
  rating     Float      @default(0.0)
  reviews    Int        @default(0)
  license    String
  languages  String[]
  isLuxury   Boolean    @default(false)
  properties Property[]
  leads      Lead[]
}

model Property {
  id           String   @id @default(uuid())
  price        Int
  beds         Float
  baths        Float
  sqft         Int
  address      String
  city         String
  state        String
  zip          String
  imageUrl     String   @default("https://images.unsplash.com/photo-1568605114967-8130f3a36994?w=800")
  status       String   @default("Active")
  propertyType String   @default("Single Family")
  
  agent      Agent    @relation(fields: [agentId], references: [id])
  agentId      String
  leads        Lead[]
}

model Lead {
  id         String    @id @default(uuid())
  name       String
  email      String
  phone      String
  message    String
  status     String    @default("New")
  date       DateTime  @default(now())
  
  agent      Agent     @relation(fields: [agentId], references: [id])
  agentId    String
  
  property   Property? @relation(fields: [propertyId], references: [id])
  propertyId String?
}
