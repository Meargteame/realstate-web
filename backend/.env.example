# =====================================================
# KW REAL ESTATE PLATFORM - ENTERPRISE CONFIGURATION
# =====================================================

# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/kw_realestate?schema=public"

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# =====================================================
# REDIS CACHING (CRITICAL FOR PERFORMANCE)
# =====================================================
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379

# =====================================================
# RATE LIMITING & SECURITY
# =====================================================
# API Keys for programmatic access (comma-separated)
API_KEYS=

# Metrics API Key (for /api/metrics endpoint)
METRICS_API_KEY=your-metrics-api-key

# =====================================================
# EMAIL SERVICE (Optional)
# =====================================================
# SendGrid
SENDGRID_API_KEY=

# SMTP (Alternative to SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@kwrealestate.com

# =====================================================
# MAPPING SERVICES (Optional)
# =====================================================
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# =====================================================
# IMAGE CDN (Optional - Recommended for Production)
# =====================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =====================================================
# MONITORING & ERROR TRACKING (Production)
# =====================================================
# Sentry for error tracking
SENTRY_DSN=

# Datadog for APM
DATADOG_API_KEY=
DATADOG_APP_KEY=

# =====================================================
# ELASTICSEARCH (Optional - For Advanced Search)
# =====================================================
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# =====================================================
# WEBSOCKET (Optional - For Real-time Features)
# =====================================================
WEBSOCKET_ENABLED=false
WEBSOCKET_PORT=5001

# =====================================================
# FEATURE FLAGS
# =====================================================
ENABLE_CACHING=true
ENABLE_RATE_LIMITING=true
ENABLE_MONITORING=true
ENABLE_EMAIL_NOTIFICATIONS=true

# =====================================================
# PERFORMANCE TUNING
# =====================================================
# Database connection pool
DATABASE_POOL_SIZE=20
DATABASE_POOL_TIMEOUT=10

# Cache TTL (seconds)
CACHE_TTL_HOT=300        # 5 minutes for hot data
CACHE_TTL_WARM=3600      # 1 hour for warm data
CACHE_TTL_COLD=86400     # 24 hours for cold data

# =====================================================
# NOTES
# =====================================================
# 1. Copy this file to .env and fill in your values
# 2. Never commit .env to version control
# 3. Redis is HIGHLY RECOMMENDED for production
# 4. Set NODE_ENV=production for production deployment
# 5. Generate strong JWT_SECRET: openssl rand -base64 32
# =====================================================
