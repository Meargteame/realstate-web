# Docker Compose environment.
# Copy to ".env" (same directory as docker-compose.yml) and fill in real values.
# This file is committed as documentation; the real .env is gitignored.

# ── Postgres ─────────────────────────────────────────────
DB_USER=torra_user
DB_PASSWORD=change-me-to-a-strong-password
DB_NAME=torra_realestate

# ── Backend ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# Production frontend URL (used for CORS + password-reset links)
FRONTEND_URL=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Email (optional) ─────────────────────────────────────
# SENDGRID_API_KEY=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ── Map (optional — OSM/Leaflet is free and works without a key) ──
# VITE_MAPBOX_ACCESS_TOKEN=
