# ── Caddy — reverse proxy for Hostinger VPS ──
# Uses :80 (HTTP only) for IP-based access.
# When you have a domain, change ":80" to "yourdomain.com" for auto-HTTPS.

:80 {
	# Let's Encrypt cert is obtained and renewed automatically.

	# Compress responses
	encode gzip zstd

	# API → backend
	handle /api/* {
		reverse_proxy backend:5000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Uploaded files → backend
	handle /uploads/* {
		reverse_proxy backend:5000 {
			header_up X-Real-IP {remote_host}
		}
	}

	# Socket.IO WebSocket → backend
	handle /socket.io/* {
		reverse_proxy backend:5000 {
			header_up Connection {>Connection}
			header_up Upgrade    {>Upgrade}
		}
	}

	# Everything else → frontend (SPA)
	handle {
		reverse_proxy frontend:80
	}

	# Security headers
	header {
		X-Content-Type-Options    nosniff
		X-Frame-Options           DENY
		Referrer-Policy           strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		-Server
	}

	# Logs
	log {
		output file /data/logs/access.log {
			roll_size 50mb
			roll_keep 5
		}
	}
}
