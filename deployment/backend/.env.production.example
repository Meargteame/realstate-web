# Production Environment Variables
# Copy this file to .env and update with your production values

# Database Configuration
# Replace with your Hostinger PostgreSQL credentials
DATABASE_URL="postgresql://username:password@localhost:5432/kw_realestate"

# JWT Secret
# Generate a secure random string (minimum 32 characters)
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secure-random-string-change-this-in-production-minimum-32-characters"

# Server Configuration
PORT=5000
NODE_ENV=production

# CORS Configuration
# Add your domain(s) separated by commas
ALLOWED_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"

# Optional: Email Configuration (for future features)
# SMTP_HOST="smtp.hostinger.com"
# SMTP_PORT=587
# SMTP_USER="your-email@yourdomain.com"
# SMTP_PASS="your-email-password"

# Optional: File Upload Configuration (for future features)
# UPLOAD_DIR="/var/www/kw-realestate/uploads"
# MAX_FILE_SIZE=5242880

# Optional: Rate Limiting
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
